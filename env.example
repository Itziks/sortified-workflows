# ========================================
# n8n Docker Stack Configuration
# ========================================

# ---- Core n8n Settings ----
N8N_ENCRYPTION_KEY=  # Generate with: openssl rand -hex 32 (REQUIRED - 32+ characters)
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/  # Change to your domain for production (e.g., https://n8n.yourdomain.com/)

# ---- Binary Data Storage (MVP: Local Filesystem) ----
N8N_DEFAULT_BINARY_DATA_MODE=filesystem  # Store binary files on local disk for MVP
N8N_BINARY_DATA_FOLDER=/home/node/.n8n/binary-data

# ---- Database Configuration ----
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=change_me  # Change this to a strong password

# ---- Execution Management (Safe Defaults) ----
EXECUTIONS_MODE=regular  # Single-node execution mode
EXECUTIONS_DATA_PRUNE=true  # Automatically clean up old execution data
EXECUTIONS_DATA_MAX_AGE=336  # Keep executions for 336 hours (~14 days)

# ---- Optional: S3 Binary Storage (For Future Migration) ----
# Uncomment and configure these when ready to migrate from local filesystem to S3
# N8N_DEFAULT_BINARY_DATA_MODE=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
# N8N_BINARY_DATA_S3_BUCKET_SUBFOLDER=prod/